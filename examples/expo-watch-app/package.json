{
  "name": "expo-watch-app",
  "version": "0.1.0",
  "private": true,
  "description": "An Expo iPhone app that adds a watch feature powered by react-native-watchos",
  "main": "index.js",
  "scripts": {
    "build:targets": "node scripts/build-targets.mjs",
    "ota:serve": "node scripts/serve-ota.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm build:targets && expo prebuild -p ios --clean"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/config-plugins": "~56.0.9",
    "expo": "~56.0.11",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-watch-connectivity": "^2.0.0",
    "react-native-watchos": "workspace:*",
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
