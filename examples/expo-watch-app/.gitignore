node_modules/
dist/
ios/
.expo/
# Generated bundles + OTA manifest (build them with `npm run build:targets`).
# The committed bits are the per-target Swift glue below.
targets/*/assets/bundle.js
targets/watch/assets/manifest.json
targets/*/assets/*.qbc
# Generated by the react-watchos config plugin from the plugin options in
# app.json — regenerated on every prebuild, so not committed. The consumer's
# per-target Swift glue (WatchApp.swift) in targets/*/ IS committed.
targets/*/expo-target.config.js
# Generated by prebuild from each target's expo-target.config.js
targets/*/Info.plist
# apple-targets <= 4 wrote generated.entitlements here; 5 writes it under
# ios/.targets/<productName>/ (already covered by the ios/ rule above). Kept so
# a leftover file from an older prebuild can't be committed by accident.
targets/*/generated.entitlements
# Per-checkout DEV OTA signing key generated by build-targets.mjs (NF-29).
# Production signing uses the OTA_SIGNING_KEY CI secret instead.
.ota-dev-key.json
