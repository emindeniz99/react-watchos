node_modules/
dist/
ios/
.expo/
# Generated bundles + OTA manifest (build them with `npm run build:watch` /
# `build:widget`). The committed bits are the per-target Swift glue below.
targets/*/assets/bundle.js
targets/watch/assets/manifest.json
targets/*/assets/*.qbc
# Generated by the react-native-watchos config plugin from the plugin options in
# app.json — regenerated on every prebuild, so not committed. The consumer's
# per-target Swift glue (WatchApp.swift) in targets/*/ IS committed.
targets/*/expo-target.config.js
# Generated by prebuild from each target's expo-target.config.js
targets/*/Info.plist
targets/*/generated.entitlements
