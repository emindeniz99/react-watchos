{
  "expo": {
    "name": "Expo Watch App",
    "slug": "expo-watch-app",
    "version": "0.1.0",
    "platforms": ["ios"],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.expowatch",
      "supportsTablet": false
    },
    "plugins": [
      [
        "react-native-watchos",
        {
          "name": "Expo Watch",
          "widget": true,
          "healthKit": false,
          "deploymentTarget": "11.0"
        }
      ]
    ]
  }
}
