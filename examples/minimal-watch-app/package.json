{
  "name": "minimal-watch-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal external app on the react-watchos engine (no source reach-in)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:min": "node scripts/build.mjs --minify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-reconciler": "0.33.0",
    "react-watchos": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
