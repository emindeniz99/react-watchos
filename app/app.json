{
  "expo": {
    "name": "React Watch Demo",
    "slug": "react-native-watchos-demo",
    "version": "0.1.0",
    "platforms": ["ios"],
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.emindeniz99.reactwatch",
      "appleTeamId": "D68Q862K33",
      "supportsTablet": false
    },
    "plugins": [
      [
        "react-native-watchos",
        {
          "name": "React Watch",
          "appGroup": "group.com.emindeniz99.reactwatch",
          "widget": true,
          "healthKit": true,
          "deploymentTarget": "10.0",
          "appleTeamId": "D68Q862K33",
          "infoPlist": {
            "NSBluetoothAlwaysUsageDescription": "Connect to a nearby device (e.g. your laptop) to control playback.",
            "NSLocationWhenInUseUsageDescription": "Show your location and route while the app is open."
          }
        }
      ]
    ]
  }
}
