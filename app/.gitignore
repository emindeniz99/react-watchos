node_modules/
ios/
android/
.expo/
targets/*/assets/*.qbc
targets/*/assets/*.hash
# Generated by `pnpm build` (esbuild) — regenerated by the prebuild script
# and CI before the Xcode build, so it isn't committed.
targets/*/assets/bundle.js
# Generated by the react-watchos config plugin from the plugin options
# in app.json — regenerated on every prebuild, so not committed. The consumer's
# per-target Swift glue in targets/*/ IS committed.
targets/*/expo-target.config.js
# Generated by prebuild from each target's expo-target.config.js
targets/*/Info.plist
# apple-targets <= 4 wrote generated.entitlements here; 5 writes it under
# ios/.targets/<productName>/ (already covered by the ios/ rule above). Kept so
# a leftover file from an older prebuild can't be committed by accident.
targets/*/generated.entitlements
