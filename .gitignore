# pnpm workspace: deps live in a shared store, symlinked into each member.
node_modules/
dist/

# pnpm is the lockfile for this workspace; npm/yarn locks must not reappear.
package-lock.json
yarn.lock

# SwiftPM build output.
.build/
# Xcode's local SwiftPM state (per-user schemes); never shared.
.swiftpm/
.history/