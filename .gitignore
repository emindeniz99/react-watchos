# pnpm workspace: deps live in a shared store, symlinked into each member.
node_modules/
dist/

# pnpm is the lockfile for this workspace; npm/yarn locks must not reappear.
package-lock.json
yarn.lock

# SwiftPM build output.
.build/

# The renderer ships a hand-written esbuild preset here (NOT build output);
# re-include it despite the repo-root `build/` ignore.
!js/build/
!js/build/**
