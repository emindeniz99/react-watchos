# pnpm workspace: deps live in a shared store, symlinked into each member.
node_modules/
dist/

# pnpm is the lockfile for this workspace; npm/yarn locks must not reappear.
package-lock.json
yarn.lock

# Env-file safety net + OS/editor junk. Duplicated from the monorepo root on
# purpose: after graduation this file IS the repo root .gitignore, and losing
# the net there is exactly how a .env leaks (2026-08-06 graduation review).
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# SwiftPM build output.
.build/
# Xcode's local SwiftPM state (per-user schemes); never shared.
.swiftpm/
.history/
# Local AI-harness state (agent worktrees, session scratch). Never source:
# committing it would drag live worktrees and machine-local settings into
# history the moment an agent runs.
.claude/
