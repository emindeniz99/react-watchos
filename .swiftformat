# SwiftFormat config for the watch/widget targets and the contract tests.
# Matches the existing hand-written style (4-space indent, Swift 6). Run from
# this directory: `swiftformat .` (or `swiftformat --lint .` to check only).
# Runs on the macOS build workflow; not Linux-verifiable here.

--swiftversion 6.0
--indent 4
--maxwidth 100
--self remove
--importgrouping testable-bottom
--commas inline
--trimwhitespace always

# Vendored quickjs is C; generated models are codegen output; .build is SwiftPM.
--exclude **/Vendor,**/Generated,**/.build,**/*.qbc
