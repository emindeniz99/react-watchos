{
  // Every Node-side tool, authored in real TypeScript and RUN (in this repo)
  // by Node 24's native type stripping (the project's .mise.toml pins
  // node = "24"). tsc (the official compiler) type-checks it here.
  //
  //   dev-only, not shipped:      scripts/  codegen/
  //   shipped source + compiled:  esbuild/  plugin/  bin/
  //
  // The PUBLISHED package cannot run these sources: Node refuses type
  // stripping under node_modules (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING),
  // so scripts/build-node.ts compiles the Node-loaded entries (bin, plugin,
  // esbuild presets) to plain JS in dist-node/ — that is what package.json's
  // `bin` and exports point at. The .cts/.mts sources still ship for the
  // `types` conditions.
  //
  // (app.plugin.js stays a literal .js — Expo's zero-config plugin resolution
  //  looks for that exact filename; it's an ESM re-export of the compiled
  //  dist-node/plugin.cjs, the single unavoidable .js in the package.)
  //
  // Unlike src/ (which the app bundler compiles to run in QuickJS), this code
  // runs on Node — so lib ES2022 (Error `cause`, etc.) + DOM globals, and the
  // two option-bag-friendly relaxations. Node needs explicit extensions on
  // relative TS imports (`./foo.cts`, `../esbuild/preset.mts`), so
  // allowImportingTsExtensions lets tsc accept them; verbatimModuleSyntax /
  // isolatedModules off so the CommonJS plugin (.cts `require`/`module.exports`)
  // type-checks. noEmit is inherited from the base — we only type-check.
  //
  // The renderer (tsconfig.json) stays ES2020-strict for QuickJS.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["scripts", "codegen", "esbuild", "plugin", "bin"]
}
