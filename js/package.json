{
  "name": "react-native-watchos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom React renderer: JSX to a serialized SwiftUI tree, runnable in QuickJS on Apple Watch",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:min": "node scripts/build.mjs --minify",
    "dev": "node scripts/dev.mjs",
    "build:bytecode": "sh ../tools/qjs-compile/run.sh",
    "check:size": "node scripts/check-size.mjs",
    "codegen": "node codegen/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "^0.32.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
