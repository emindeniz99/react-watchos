{
  "name": "react-native-watchos",
  "version": "0.1.0",
  "type": "module",
  "description": "Custom React renderer: JSX to a serialized SwiftUI tree, runnable in QuickJS on Apple Watch",
  "keywords": [
    "react",
    "react-native",
    "watchos",
    "apple-watch",
    "swiftui",
    "quickjs",
    "react-reconciler",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/emindeniz99/playground.git",
    "directory": "projects/react-native-watchos/js"
  },
  "sideEffects": [
    "./src/install-shims.ts",
    "./src/shims.ts",
    "./src/widgets.ts",
    "./src/intents.ts"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "app.plugin.js": "./app.plugin.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./esbuild/preset.d.mts",
      "default": "./esbuild/preset.mjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./src/testing.ts",
      "react-native": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./app.plugin": "./app.plugin.js",
    "./link-swift-package": "./plugin/link-swift-package.cjs",
    "./merge-target-infoplist": "./plugin/merge-target-infoplist.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "esbuild",
    "app.plugin.js",
    "plugin",
    "swift",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:min": "node scripts/build.mjs --minify",
    "dev": "node scripts/dev.mjs",
    "inspector": "node scripts/inspector.mjs",
    "build:bytecode": "sh ../tools/qjs-compile/run.sh",
    "check:size": "node scripts/check-size.mjs",
    "codegen": "node codegen/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "peerDependencies": {
    "@bacons/apple-targets": ">=4.0.0",
    "@expo/config-plugins": ">=56.0.0",
    "expo": ">=56.0.0",
    "react": "^19.2.0",
    "react-reconciler": "0.33.0"
  },
  "peerDependenciesMeta": {
    "@bacons/apple-targets": { "optional": true },
    "@expo/config-plugins": { "optional": true },
    "expo": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-react": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@biomejs/biome": "2.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "^0.32.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.27.0",
    "react": "^19.2.0",
    "react-reconciler": "0.33.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
